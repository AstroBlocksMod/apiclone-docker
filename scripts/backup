#!/usr/bin/env bash
# Backs up the production database and uploaded files while the stack runs.
#
# Usage: scripts/backup [directory]   (default: backups/<UTC timestamp>)
source "$(dirname "$0")/lib.sh"

engine="$(env_value DB_ENGINE mysql)"
[[ -z "$(env_value DB_HOST)" ]] || die "DB_HOST is set, so the database is outside this stack. Back it up with its own tools."

dest="${1:-backups/$(date -u +%Y%m%dT%H%M%SZ)}"
[[ ! -e "$dest" ]] || die "$dest already exists"
mkdir -p "$dest"
echo "$engine" >"$dest/engine"

# Single quotes are deliberate below: the variables expand inside the container.
# shellcheck disable=SC2016
case "$engine" in
mysql)
	# The skips leave out server-wide state (GTID position, masking policies)
	# that APIClone's database user may not read and a restore does not need.
	prod_compose exec -T mysql sh -c \
		'exec mysqldump --single-transaction --no-tablespaces --set-gtid-purged=OFF --skip-masking-policies -u"$MYSQL_USER" -p"$MYSQL_PASSWORD" "$MYSQL_DATABASE"' |
		gzip >"$dest/database.sql.gz"
	;;
mariadb)
	prod_compose exec -T mariadb sh -c \
		'exec mariadb-dump --single-transaction -u"$MARIADB_USER" -p"$MARIADB_PASSWORD" "$MARIADB_DATABASE"' |
		gzip >"$dest/database.sql.gz"
	;;
sqlite)
	# The sqlite3 backup API gives a consistent copy while APIClone is running.
	prod_compose exec -T apiclone python -c '
import sqlite3, sys
src = sqlite3.connect("/data/db.sqlite3")
dst = sqlite3.connect("/tmp/backup.sqlite3")
src.backup(dst)
dst.close()
sys.stdout.buffer.write(open("/tmp/backup.sqlite3", "rb").read())
' >"$dest/database.sqlite3"
	prod_compose exec -T apiclone rm -f /tmp/backup.sqlite3
	;;
*) die "unknown DB_ENGINE $engine" ;;
esac

prod_compose exec -T apiclone tar -C /data -czf - files >"$dest/files.tar.gz"
echo "Backed up to $dest"
