# Copy this file to .env and fill it in. Docker Compose reads .env from the repo
# root for both compose files. Lines left empty fall back to the default shown.

# Production

# Where people reach the site, with no trailing slash. scratch-www bakes this
# into its build, so run `scripts/prod build` again after changing it.
SITE_URL=https://scratch.example.com
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Database: mysql (default), mariadb or sqlite. PostgreSQL does not work with
# APIClone yet (see the README).
DB_ENGINE=mysql
# Starts the database service for DB_ENGINE. Leave as is.
COMPOSE_PROFILES=${DB_ENGINE}
DB_NAME=apiclone
DB_USER=apiclone
# Required for mysql and mariadb.
DB_PASSWORD=
# Only for a database outside this stack. Defaults to the service for DB_ENGINE.
DB_HOST=
DB_PORT=

# Ports nginx is published on.
HTTP_PORT=80
HTTPS_PORT=443
# A directory with fullchain.pem and privkey.pem turns on HTTPS. Without them,
# nginx serves plain HTTP, for example behind another proxy that handles TLS.
TLS_CERT_DIR=./certs

# Mail. Without EMAIL_HOST, mail is written to files in the data volume.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
REQUIRE_EMAIL_VERIFICATION=false

# More host names APIClone should answer to, comma separated.
EXTRA_ALLOWED_HOSTS=
# More origins allowed to make cross-site requests, comma separated, for
# example https://www.scratch.example.com.
EXTRA_ORIGINS=
# A Valkey or Redis server outside this stack.
REDIS_URL=
LOG_LEVEL=INFO

# Both modes

# Shows the theme selector in the footer. THEME_SELECTION_DEFAULT is one of the
# theme IDs in THEME_SELECTION in APIClone's settings.py, such as prpl_26.
USE_THEME_SELECTOR=false
THEME_SELECTION_DEFAULT=

# Upstream sources. The defaults, pinned in the Dockerfile, are what this repo
# is tested with. Uncomment to build something else; an empty value breaks the
# build, so leave them commented out otherwise.
#APICLONE_REPO=https://codeberg.org/heathercat123/apiclone.git
#APICLONE_COMMIT=
#WWW_REPO=https://github.com/scratchfoundation/scratch-www.git
#WWW_COMMIT=

# Development

# Checkouts the dev servers run from. scripts/fetch clones them here.
APICLONE_SRC=./upstream/apiclone
WWW_SRC=./upstream/scratch-www
APICLONE_PORT=8000
WWW_PORT=8333
